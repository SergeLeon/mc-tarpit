# keep LF in the repository and in checkouts: shell scripts, systemd units and
# nftables configs with CRLF do not work on Linux
* text=auto eol=lf
*.py text eol=lf
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.md text eol=lf
*.yml text eol=lf

# release archive (git archive / releases/latest download): keep the installer,
# the tool and contrib/, drop CI and tests noise
/.github    export-ignore
/tests      export-ignore
